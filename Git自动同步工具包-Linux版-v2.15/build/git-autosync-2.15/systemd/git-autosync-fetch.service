[Unit]
Description=Git AutoSync scheduled mirror fetch (one-shot)
Documentation=file:/usr/share/git-autosync/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=GIT_AUTOSYNC_PREFIX=/usr/share/git-autosync
Environment=GIT_AUTOSYNC_CONF=/etc/git-autosync
Environment=GIT_AUTOSYNC_LOG=/var/log/git-autosync
ExecStart=/usr/share/git-autosync/bin/git-autosync-fetch --once
SyslogIdentifier=git-autosync-fetch
