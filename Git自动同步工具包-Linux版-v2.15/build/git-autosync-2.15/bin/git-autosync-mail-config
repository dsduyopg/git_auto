#!/usr/bin/env bash
# ============================================================
# Git AutoSync Toolkit (Linux) - email notification setup wizard
# Ported from the Windows version: configure-SMTP.bat + manage_recipients.ps1
#                                + set_notify_interval.ps1
#                                + enable_mail_on_service.ps1
#
# Config: /etc/git-autosync/mail_config.txt
#   (stored under /etc so the systemd service running as root can read it)
#
# Usage: git-autosync mail
# ============================================================

set -uo pipefail

SELF_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SELF_DIR="$(cd "$(dirname "$SELF_PATH")" && pwd)"
# shellcheck source=/dev/null
. "${SELF_DIR}/../lib/common.sh"

if [ "$(id -u)" -ne 0 ]; then
    err "This operation requires root privileges (it writes to ${MAIL_CONF}). Run with sudo"
    exit 1
fi

mkdir -p "$(dirname "$MAIL_CONF")"
touch "$MAIL_CONF"
chmod 0600 "$MAIL_CONF" 2>/dev/null   # contains the SMTP auth code; tighten permissions

declare -A PRESET_SERVER PRESET_PORT PRESET_SSL
PRESET_SERVER=([QQ]="smtp.qq.com"    [163]="smtp.163.com"  [Gmail]="smtp.gmail.com")
PRESET_PORT=([QQ]="465"              [163]="465"           [Gmail]="587")
PRESET_SSL=([QQ]="1"                 [163]="1"             [Gmail]="0")

cur_enabled="$(conf_get "$MAIL_CONF" enabled || echo 0)"

status_line() {
    if [ "$cur_enabled" = "1" ]; then
        ok "Email notification: enabled (from $(conf_get "$MAIL_CONF" from || echo '?') -> $(conf_get "$MAIL_CONF" to || echo '?'))"
    else
        warn "Email notification: disabled (no mail is sent until configured; same as v2.14 behavior)"
    fi
}

# ---------- Enable and bind SMTP ----------
do_enable() {
    title "Enable email notification and bind SMTP"
    hr
    echo "Select mailbox type:"
    echo "  1) QQ Mail     2) 163 Mail     3) Gmail     4) Custom"
    local t server port ssl
    read -r -p "Choose [1-4] (default 1): " t
    case "$t" in
        2) server="${PRESET_SERVER[163]}"; port="${PRESET_PORT[163]}"; ssl="${PRESET_SSL[163]}";;
        3) server="${PRESET_SERVER[Gmail]}"; port="${PRESET_PORT[Gmail]}"; ssl="${PRESET_SSL[Gmail]}";;
        4) server="$(ask "  SMTP server address")"; port="$(ask "  Port" "465")"; ssl="$(ask "  Use SSL? 1=yes 0=no (port 587 usually 0)" "0")";;
        *) server="${PRESET_SERVER[QQ]}"; port="${PRESET_PORT[QQ]}"; ssl="${PRESET_SSL[QQ]}";;
    esac

    local from pass pass2 to
    from="$(ask "Sender email address")"
    echo
    warn "You must enter the SMTP authorization code, NOT your mailbox login password!"
    info "  QQ Mail : Settings -> Account -> POP3/SMTP service -> generate authorization code"
    info "  163 Mail: Settings -> POP3/SMTP/IMAP -> enable -> generate authorization code"
    echo
    info "Note: nothing is echoed while you type (like a sudo password)."
    info "      Press Enter when done. You need to type it twice, and they must match."
    echo
    while true; do
        read -r -s -p "SMTP authorization code: " pass; echo
        if [ -z "$pass" ]; then
            err "The authorization code cannot be empty, please try again"
            continue
        fi
        read -r -s -p "Confirm it once more: " pass2; echo
        if [ "$pass" = "$pass2" ]; then
            ok "The two entries match, confirmed"
            break
        fi
        err "The two entries do not match, please try again"
    done
    to="$(ask "Recipient email(s), comma separated" "$from")"

    [ -n "$server" ] && [ -n "$from" ] && [ -n "$pass" ] && [ -n "$to" ] || { err "Incomplete information, cancelled"; return 1; }

    conf_set "$MAIL_CONF" enabled      1
    conf_set "$MAIL_CONF" smtp_server  "$server"
    conf_set "$MAIL_CONF" smtp_port    "$port"
    conf_set "$MAIL_CONF" use_ssl      "$ssl"
    conf_set "$MAIL_CONF" from         "$from"
    conf_set "$MAIL_CONF" password     "$pass"
    conf_set "$MAIL_CONF" to           "$to"
    conf_set "$MAIL_CONF" notify_interval "$(conf_get "$MAIL_CONF" notify_interval || echo 0)"

    chmod 0600 "$MAIL_CONF" 2>/dev/null
    ok "SMTP settings saved: $from -> $to ($server:$port)"
    cur_enabled=1
}

# ---------- Disable ----------
do_disable() {
    conf_set "$MAIL_CONF" enabled 0
    ok "Email notification disabled (syncing is unaffected)"
    cur_enabled=0
}

# ---------- Send a test mail ----------
do_test() {
    if [ "$cur_enabled" != "1" ]; then
        err "Email notification is not enabled yet, please choose [1] first"
        return 1
    fi
    info "Sending a test mail (throttling skipped)..."
    "${SELF_DIR}/git-autosync-mail" -f \
        -s "[GitAutoSync] Test mail" \
        -b "This is a test mail from the Git AutoSync Toolkit (Linux).
Time: $(date '+%Y-%m-%d %H:%M:%S')
Host: $(hostname)

Receiving this mail means your SMTP settings are correct."
    echo
    tail -n 5 "$MAIL_LOG" 2>/dev/null || true
    echo
    confirm "Did you receive the test mail?" && ok "Setup complete!" || warn "If not, check: email address, authorization code, SMTP port (see the log above)"
}

# ---------- Manage recipients ----------
do_recipients() {
    title "Manage recipients"
    echo "  1) Show current recipients"
    echo "  2) Change recipients (comma separated)"
    local c
    read -r -p "Choose: " c
    case "$c" in
        1) echo "Current recipients: $(conf_get "$MAIL_CONF" to || echo 'not set')";;
        2)
            local to
            to="$(ask "New recipients, comma separated" "$(conf_get "$MAIL_CONF" to || echo '')")"
            conf_set "$MAIL_CONF" to "$to"
            ok "Recipients updated: $to"
            ;;
    esac
}

# ---------- Notification interval (aggregation window) ----------
do_interval() {
    title "Set notification interval (aggregation window)"
    info "0  = send instantly (one mail per sync)"
    info ">0 = at most one mail within that many minutes, avoids flooding on frequent changes"
    local v
    v="$(ask "Interval in minutes (0-1440)" "$(conf_get "$MAIL_CONF" notify_interval || echo 0)")"
    if [[ "$v" =~ ^[0-9]+$ ]] && [ "$v" -ge 0 ] && [ "$v" -le 1440 ]; then
        conf_set "$MAIL_CONF" notify_interval "$v"
        ok "Set to ${v} minutes"
    else
        err "Invalid input"
    fi
}

# ---------- Enable/disable mail notification per repository ----------
do_repo_toggle() {
    title "Toggle email notification for a repository"
    local repos r i=1 sel name
    repos="$(list_repos)"
    if [ -z "$repos" ]; then
        warn "No repositories registered yet"
        return 0
    fi
    while IFS= read -r r; do
        local st
        st="$(conf_get "${REPO_CONF_DIR}/${r}.conf" mail_notify || echo 0)"
        printf '  %d) %-24s mail notification: %s\n' "$i" "$r" "$([ "$st" = "1" ] && echo on || echo off)"
        i=$((i + 1))
    done <<EOF
$repos
EOF
    read -r -p "Select number: " sel
    name="$(printf '%s\n' "$repos" | sed -n "${sel}p")"
    [ -n "$name" ] || { err "Invalid selection"; return 1; }

    local cur
    cur="$(conf_get "${REPO_CONF_DIR}/${name}.conf" mail_notify || echo 0)"
    if [ "$cur" = "1" ]; then
        conf_set "${REPO_CONF_DIR}/${name}.conf" mail_notify 0
        ok "Email notification disabled for ${name}"
    else
        conf_set "${REPO_CONF_DIR}/${name}.conf" mail_notify 1
        ok "Email notification enabled for ${name}"
    fi
    if has_systemd; then
        confirm "Restart the service to apply the change?" && systemctl restart "git-autosync@${name}.service" && ok "Restarted"
    fi
}

# ---------- Main menu ----------
while true; do
    title "Email notification setup (optional feature, off by default)"
    status_line
    hr
    echo "  1) Enable and bind SMTP"
    echo "  2) Disable email notification"
    echo "  3) Send a test mail"
    echo "  4) Manage recipients"
    echo "  5) Set notification interval (anti-flood)"
    echo "  6) Toggle email notification per repository"
    echo "  7) View mail log"
    echo "  0) Back"
    echo
    local_c=""
    read -r -p "Choose [0-7]: " local_c
    case "$local_c" in
        1) do_enable;;
        2) do_disable;;
        3) do_test;;
        4) do_recipients;;
        5) do_interval;;
        6) do_repo_toggle;;
        7) tail -n 20 "$MAIL_LOG" 2>/dev/null || warn "No mail log yet";;
        0) exit 0;;
        *) warn "Invalid choice";;
    esac
    echo
    read -r -p "Press Enter to continue..." || true
done
