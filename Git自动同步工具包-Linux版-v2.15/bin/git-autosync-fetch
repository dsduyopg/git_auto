#!/usr/bin/env bash
# ============================================================
# Git AutoSync Toolkit (Linux) - cloud mirror fetcher
# Ported from the Windows version: change_fetcher_generic.ps1
#   NSSM resident service GitMirrorFetcher -> systemd timer git-autosync-fetch.timer
#
# Usage:
#   git-autosync-fetch           run one round and exit (used by the systemd timer)
#   git-autosync-fetch --daemon  resident loop, pull every interval minutes
#                                (same behavior as the Windows version)
#
# Registry: /etc/git-autosync/mirror_config.txt
#   Each line:  target-directory|remote-URL|branch|SSH-key-path
#   The 4th column is optional (default key is used); lines starting with # are comments
# Interval: /etc/git-autosync/mirror_settings.txt -> interval=60
# ============================================================

set -uo pipefail

SELF_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SELF_DIR="$(cd "$(dirname "$SELF_PATH")" && pwd)"
# shellcheck source=/dev/null
. "${SELF_DIR}/../lib/common.sh"

LOG_DIR="${GIT_AUTOSYNC_LOG:-/var/log/git-autosync}"
LOG_FILE="${LOG_DIR}/mirror_fetcher.log"
mkdir -p "$LOG_DIR" 2>/dev/null

log() { log_line "$LOG_FILE" "$*"; }

# ---- Pull interval (minutes), default 60, range 1-1440 ----
INTERVAL=60
if [ -f "$MIRROR_SETTINGS" ]; then
    _v="$(conf_get "$MIRROR_SETTINGS" interval || true)"
    if [[ "$_v" =~ ^[0-9]+$ ]] && [ "$_v" -ge 1 ] && [ "$_v" -le 1440 ]; then
        INTERVAL="$_v"
    fi
fi

# ---- Whether to clean untracked files (set GIT_MIRROR_CLEAN=0 to disable) ----
CLEAN_UNTRACKED=1
if [ "${GIT_MIRROR_CLEAN:-1}" = "0" ]; then
    CLEAN_UNTRACKED=0
fi

# ---- Default SSH private key: the first key under the SSH directory ----
SSH_HOME="${MIRROR_SSH_HOME:-/root/.ssh}"
DEFAULT_KEY="$(conf_get "$MIRROR_SETTINGS" default_ssh_key 2>/dev/null || true)"
if [ -z "$DEFAULT_KEY" ] && [ -d "$SSH_HOME" ]; then
    DEFAULT_KEY="$(find "$SSH_HOME" -maxdepth 1 -type f \
        ! -name '*.pub' ! -name 'known_hosts' ! -name 'config' \
        ! -name 'authorized_keys' 2>/dev/null | sort | head -n1)"
fi

# ---- Email notification (optional; skipped silently when not configured) ----
notify_mail() {
    local subject="$1" content="$2"
    [ -x "${SELF_DIR}/git-autosync-mail" ] || return 0
    "${SELF_DIR}/git-autosync-mail" -s "$subject" -b "$content" >/dev/null 2>&1 || true
}

# ---- Update a single mirror ----
update_mirror() {
    local dir="$1" url="$2" branch="$3" key="${4:-}"
    local out

    [ -n "$key" ] || key="$DEFAULT_KEY"
    if [ -n "$key" ] && [ -f "$key" ]; then
        export GIT_SSH_COMMAND="$(ssh_cmd_for "$key")"
    fi

    if [ ! -d "${dir}/.git" ]; then
        mkdir -p "$(dirname "$dir")" 2>/dev/null
        if out="$(git clone "$url" "$dir" 2>&1)"; then
            git -C "$dir" checkout "$branch" >/dev/null 2>&1
            log "Cloned ${dir}"
            notify_mail "Pull OK: ${dir}" "Target: ${dir}
Branch: ${branch}
Time: $(date '+%Y-%m-%d %H:%M:%S')
Result: cloned successfully"
        else
            log "Clone failed ${dir}: ${out}"
            notify_mail "Pull FAILED: ${dir}" "Target: ${dir}
Time: $(date '+%Y-%m-%d %H:%M:%S')
Result: clone failed
Error: ${out}"
        fi
        return
    fi

    if ! out="$(git -C "$dir" fetch origin "$branch" 2>&1)"; then
        log "fetch failed ${dir}: ${out}"
        notify_mail "Pull FAILED: ${dir}" "Target: ${dir}
Time: $(date '+%Y-%m-%d %H:%M:%S')
Result: fetch failed
Error: ${out}"
        return
    fi

    git -C "$dir" reset --hard "origin/${branch}" >/dev/null 2>&1
    if [ "$CLEAN_UNTRACKED" -eq 1 ]; then
        git -C "$dir" clean -fd >/dev/null 2>&1
    fi
    log "Updated ${dir} -> origin/${branch}"
    notify_mail "Pull OK: ${dir}" "Target: ${dir}
Branch: origin/${branch}
Time: $(date '+%Y-%m-%d %H:%M:%S')
Result: updated successfully"
}

# ---- Run one round ----
run_once() {
    local count=0 dir url branch key line

    if [ ! -f "$MIRROR_CONF" ]; then
        log "Registry not found: $MIRROR_CONF (register one first via git-autosync -> New cloud mirror pull)"
        return 0
    fi
    if [ -z "$DEFAULT_KEY" ] && ! grep -qE '^[^#]*\|[^|]*\|[^|]*\|[^|]+' "$MIRROR_CONF"; then
        log "No SSH private key found, and the registry does not specify a key per entry"
        return 1
    fi

    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%%#*}"                       # strip inline comments
        line="$(printf '%s' "$line" | tr -d '\r')"
        [ -n "$(printf '%s' "$line" | tr -d '[:space:]')" ] || continue

        IFS='|' read -r dir url branch key <<EOF
$line
EOF
        dir="$(printf '%s' "$dir" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        url="$(printf '%s' "$url" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        branch="$(printf '%s' "$branch" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        key="$(printf '%s' "$key" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"

        [ -n "$dir" ] && [ -n "$url" ] || continue
        [ -n "$branch" ] || branch="main"

        update_mirror "$dir" "$url" "$branch" "$key"
        count=$((count + 1))
    done < "$MIRROR_CONF"

    log "Round finished, processed ${count} mirror(s)"
}

# ---- Entry point ----
if ! need_cmd git; then err "git command not found"; exit 1; fi

case "${1:-}" in
    --daemon)
        log "============================================"
        log "change fetcher started (resident mode), interval: ${INTERVAL} minutes"
        log "Registry: ${MIRROR_CONF}  clean untracked files: ${CLEAN_UNTRACKED}"
        run_once
        while true; do
            sleep $((INTERVAL * 60))
            log "----- new detection round -----"
            run_once
        done
        ;;
    *)
        run_once
        ;;
esac
