#!/usr/bin/env bash
# ============================================================
# Git 自动同步工具包 (Linux 版) - 实时同步守护
# 移植自 Windows 版 git_sync_realtime_*.ps1
#   FileSystemWatcher  ->  inotifywait
#   NSSM 服务          ->  systemd 服务 (git-autosync@<名称>.service)
#
# 用法: git-autosync-sync <仓库名>
# 配置: /etc/git-autosync/repos/<仓库名>.conf
# ============================================================

set -uo pipefail

SELF_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SELF_DIR="$(cd "$(dirname "$SELF_PATH")" && pwd)"
# shellcheck source=/dev/null
. "${SELF_DIR}/../lib/common.sh"

REPO_NAME="${1:-}"
if [ -z "$REPO_NAME" ]; then
    err "用法: $(basename "$0") <仓库名>"
    exit 1
fi

CONF="${REPO_CONF_DIR}/${REPO_NAME}.conf"
if [ ! -f "$CONF" ]; then
    err "找不到仓库配置：$CONF"
    exit 1
fi

# ---- 读取仓库配置 ----
REPO_PATH="$(conf_get "$CONF" repo_path)"
BRANCH="$(conf_get "$CONF" branch || echo main)"
REMOTE="$(conf_get "$CONF" remote || echo origin)"
SSH_KEY="$(conf_get "$CONF" ssh_key || true)"
DEBOUNCE="$(conf_get "$CONF" debounce || echo 3)"
RETRY_TIMES="$(conf_get "$CONF" retry || echo 3)"
RETRY_WAIT="$(conf_get "$CONF" retry_wait || echo 5)"
MAIL_NOTIFY="$(conf_get "$CONF" mail_notify || echo 0)"
LOG_FILE="$(conf_get "$CONF" log_file || echo "${REPO_PATH}/git_sync.log")"
EXTRA_EXCLUDE="$(conf_get "$CONF" exclude || true)"

if [ -z "$REPO_PATH" ]; then
    err "配置缺少 repo_path：$CONF"
    exit 1
fi

# ---- 日志（写文件 + 输出，systemd 会收集到 journal） ----
log() { log_line "$LOG_FILE" "$*"; }

# ---- 发送邮件通知（失败绝不影响同步主流程） ----
notify_mail() {
    local success="$1" detail="$2" subject body files
    if [ "$MAIL_NOTIFY" != "1" ]; then return 0; fi
    if [ ! -x "${SELF_DIR}/git-autosync-mail" ]; then return 0; fi

    if [ "$success" = "1" ]; then
        subject="[Git同步成功] ${REPO_PATH}"
    else
        subject="[Git同步失败] ${REPO_PATH}"
    fi

    files="$(changed_files)"
    body="仓库: ${REPO_PATH}
分支: ${REMOTE}/${BRANCH}
时间: $(date '+%Y-%m-%d %H:%M:%S')
结果: $([ "$success" = "1" ] && echo '推送成功' || echo '推送失败')
${detail}"
    if [ -n "$files" ]; then
        body="${body}

变更文件:
${files}"
    fi

    "${SELF_DIR}/git-autosync-mail" -s "$subject" -b "$body" >/dev/null 2>&1 || true
}

# ---- 最近变更文件列表（对应 Get-ChangedFiles，支持中文文件名） ----
changed_files() {
    git -C "$REPO_PATH" -c core.quotePath=false \
        log --since="10 minutes ago" --name-only --pretty=format: . 2>/dev/null \
        | sed '/^$/d' | sort -u | head -50
}

# ---- 核心同步：add -> commit -> push（含重试） ----
sync_now() {
    local status msg out i

    # v2.14 起的核心逻辑：清理残留 index.lock，避免同步卡死
    clear_index_lock "$REPO_PATH"

    if ! git -C "$REPO_PATH" add -A >/dev/null 2>&1; then
        log "git add 失败"
        notify_mail 0 "git add 失败"
        return 1
    fi

    status="$(git -C "$REPO_PATH" status --porcelain 2>/dev/null)"
    if [ -z "$status" ]; then
        log "无实际文件变动，跳过提交"
        return 0
    fi

    msg="auto-sync: $(date '+%Y-%m-%d %H:%M:%S')"
    if ! git -C "$REPO_PATH" commit -m "$msg" >/dev/null 2>&1; then
        log "git commit 失败"
        notify_mail 0 "git commit 失败"
        return 1
    fi
    log "已提交：$msg"

    for ((i = 1; i <= RETRY_TIMES; i++)); do
        if out="$(git -C "$REPO_PATH" push "$REMOTE" "$BRANCH" 2>&1)"; then
            log "推送成功 -> ${REMOTE}/${BRANCH}"
            notify_mail 1 "已推送到 ${REMOTE}/${BRANCH}"
            return 0
        fi
        log "推送失败(第 ${i}/${RETRY_TIMES} 次)：${out}"
        [ "$i" -lt "$RETRY_TIMES" ] && sleep "$RETRY_WAIT"
    done

    log "推送失败，超过重试次数，将在下次变化时重试"
    notify_mail 0 "推送失败，超过重试次数。最后一次错误: ${out}"
    return 1
}

# ---- 前置检查 ----
if ! need_cmd git; then err "未找到 git 命令，请先安装 Git"; exit 1; fi
if [ ! -d "$REPO_PATH" ]; then err "目录不存在：${REPO_PATH}"; exit 1; fi
if [ ! -d "${REPO_PATH}/.git" ]; then err "该目录不是 git 仓库：${REPO_PATH}"; exit 1; fi
if ! git -C "$REPO_PATH" remote 2>/dev/null | grep -qx "$REMOTE"; then
    err "未配置远程仓库 ${REMOTE}"
    exit 1
fi

# 指定 SSH 私钥（对应 core.sshCommand）
if [ -n "$SSH_KEY" ]; then
    export GIT_SSH_COMMAND="$(ssh_cmd_for "$SSH_KEY")"
fi

log "============================================"
log "Git 实时同步启动：${REPO_PATH}（分支 ${BRANCH}，防抖 ${DEBOUNCE}s）"

# ---- 启动时先完整同步一次 ----
log "启动时执行一次完整同步..."
sync_now

# ---- 实时监听 ----
if ! need_cmd inotifywait; then
    err "未找到 inotifywait，无法实时监听。请安装 inotify-tools："
    err "  sudo dnf install -y inotify-tools   # RHEL/CentOS/Fedora"
    err "  sudo apt install -y inotify-tools   # Debian/Ubuntu"
    exit 1
fi

log "开始实时监听目录：${REPO_PATH}"

# 排除：.git 目录（否则 git 操作自身会触发无限循环）、同步日志、用户自定义项
EXCLUDE='/\.git($|/)|/\.git$|git_sync.*\.log$'
if [ -n "$EXTRA_EXCLUDE" ]; then
    EXCLUDE="${EXCLUDE}|${EXTRA_EXCLUDE}"
fi

# 防抖主循环：
#   read -t N 在 N 秒内读不到新事件即表示进入静默期，此时执行一次同步，
#   从而把防抖窗口内的连续改动合并成一次提交（等价 Windows 版 3 秒防抖语义）
pending=0
while true; do
    if read -r -t "$DEBOUNCE" _line; then
        pending=1
        continue
    fi
    if [ "$pending" -eq 1 ]; then
        pending=0
        sync_now
    fi
done < <(inotifywait -m -r -q \
    -e modify -e create -e delete -e move -e close_write \
    --exclude "$EXCLUDE" \
    --format '%w%f' "$REPO_PATH" 2>/dev/null)
