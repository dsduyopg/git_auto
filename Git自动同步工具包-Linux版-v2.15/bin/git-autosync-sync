#!/usr/bin/env bash
# ============================================================
# Git AutoSync Toolkit (Linux) - real-time sync daemon
# Ported from the Windows version: git_sync_realtime_*.ps1
#   FileSystemWatcher  ->  inotifywait
#   NSSM service       ->  systemd service (git-autosync@<name>.service)
#
# Usage: git-autosync-sync <repo-name>
# Config: /etc/git-autosync/repos/<repo-name>.conf
# ============================================================

set -uo pipefail

cleanup() {
    trap - TERM INT
    jobs -p 2>/dev/null | xargs -r kill 2>/dev/null || :
    exit 0
}
trap cleanup TERM INT

SELF_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SELF_DIR="$(cd "$(dirname "$SELF_PATH")" && pwd)"
# shellcheck source=/dev/null
. "${SELF_DIR}/../lib/common.sh"

REPO_NAME="${1:-}"
if [ -z "$REPO_NAME" ]; then
    err "Usage: $(basename "$0") <repo-name>"
    exit 1
fi

CONF="${REPO_CONF_DIR}/${REPO_NAME}.conf"
if [ ! -f "$CONF" ]; then
    err "Repository config not found: $CONF"
    exit 1
fi

# ---- Read repository config ----
REPO_PATH="$(conf_get "$CONF" repo_path)"
BRANCH="$(conf_get "$CONF" branch || echo main)"
REMOTE="$(conf_get "$CONF" remote || echo origin)"
SSH_KEY="$(conf_get "$CONF" ssh_key || true)"
DEBOUNCE="$(conf_get "$CONF" debounce || echo 3)"
RETRY_TIMES="$(conf_get "$CONF" retry || echo 3)"
RETRY_WAIT="$(conf_get "$CONF" retry_wait || echo 5)"
MAIL_NOTIFY="$(conf_get "$CONF" mail_notify || echo 0)"
LOG_FILE="$(conf_get "$CONF" log_file || echo "${REPO_PATH}/git_sync.log")"
EXTRA_EXCLUDE="$(conf_get "$CONF" exclude || true)"

if [ -z "$REPO_PATH" ]; then
    err "Config is missing repo_path: $CONF"
    exit 1
fi

# ---- Logging (file + stdout; systemd collects it into the journal) ----
log() { log_line "$LOG_FILE" "$*"; }

# ---- Send email notification (failure never blocks the sync flow) ----
notify_mail() {
    local success="$1" detail="$2" subject body files
    if [ "$MAIL_NOTIFY" != "1" ]; then return 0; fi
    if [ ! -x "${SELF_DIR}/git-autosync-mail" ]; then return 0; fi

    if [ "$success" = "1" ]; then
        subject="[Git sync OK] ${REPO_PATH}"
    else
        subject="[Git sync FAILED] ${REPO_PATH}"
    fi

    files="$(changed_files)"
    body="Repository: ${REPO_PATH}
Branch: ${REMOTE}/${BRANCH}
Time: $(date '+%Y-%m-%d %H:%M:%S')
Result: $([ "$success" = "1" ] && echo 'push succeeded' || echo 'push failed')
${detail}"
    if [ -n "$files" ]; then
        body="${body}

Changed files:
${files}"
    fi

    "${SELF_DIR}/git-autosync-mail" -s "$subject" -b "$body" >/dev/null 2>&1 || true
}

# ---- Recently changed files (see Get-ChangedFiles; supports non-ASCII names) ----
changed_files() {
    git -C "$REPO_PATH" -c core.quotePath=false \
        log --since="10 minutes ago" --name-only --pretty=format: . 2>/dev/null \
        | sed '/^$/d' | sort -u | head -50
}

# ---- Core sync: add -> commit -> push (with retry) ----
sync_now() {
    local status msg out i

    # Core behavior since v2.14: clear a stale index.lock so syncing cannot stall
    clear_index_lock "$REPO_PATH"

    if ! git -C "$REPO_PATH" add -A >/dev/null 2>&1; then
        log "git add failed"
        notify_mail 0 "git add failed"
        return 1
    fi

    status="$(git -C "$REPO_PATH" status --porcelain 2>/dev/null)"
    if [ -z "$status" ]; then
        log "No real file changes; skipping commit"
        return 0
    fi

    msg="auto-sync: $(date '+%Y-%m-%d %H:%M:%S')"
    if ! git -C "$REPO_PATH" commit -m "$msg" >/dev/null 2>&1; then
        log "git commit failed"
        notify_mail 0 "git commit failed"
        return 1
    fi
    log "Committed: $msg"

    for ((i = 1; i <= RETRY_TIMES; i++)); do
        if out="$(git -C "$REPO_PATH" push "$REMOTE" "$BRANCH" 2>&1)"; then
            log "Push succeeded -> ${REMOTE}/${BRANCH}"
            notify_mail 1 "Pushed to ${REMOTE}/${BRANCH}"
            return 0
        fi
        log "Push failed (attempt ${i}/${RETRY_TIMES}): ${out}"
        # Friendly hint: SSH public key problems are the most common cause of push failure
        if echo "$out" | grep -qiE 'Permission denied|publickey|Could not read from remote repository'; then
            log "Hint: the remote refused access; usually the SSH public key is missing or untrusted."
            log "      Run: sudo git-autosync ssh-key   to generate a key,"
            log "      then add the printed public key to SSH Keys in Gitee/GitHub."
        fi
        [ "$i" -lt "$RETRY_TIMES" ] && sleep "$RETRY_WAIT"
    done

    log "Push failed after all retries; will retry on the next change"
    notify_mail 0 "Push failed after all retries. Last error: ${out}"
    return 1
}

# ---- Pre-flight checks ----
if ! need_cmd git; then err "git command not found, please install Git"; exit 1; fi
if [ ! -d "$REPO_PATH" ]; then err "Directory does not exist: ${REPO_PATH}"; exit 1; fi
if [ ! -d "${REPO_PATH}/.git" ]; then err "Not a git repository: ${REPO_PATH}"; exit 1; fi
if ! git -C "$REPO_PATH" remote 2>/dev/null | grep -qx "$REMOTE"; then
    err "Remote ${REMOTE} is not configured"
    exit 1
fi

# Use a specific SSH private key (equivalent to core.sshCommand)
if [ -n "$SSH_KEY" ]; then
    export GIT_SSH_COMMAND="$(ssh_cmd_for "$SSH_KEY")"
fi

log "============================================"
log "Git real-time sync started: ${REPO_PATH} (branch ${BRANCH}, debounce ${DEBOUNCE}s)"

# ---- Run one full sync at startup ----
log "Running a full sync at startup..."
sync_now

# ---- Real-time watching ----
if ! need_cmd inotifywait; then
    err "inotifywait not found; cannot watch in real time. Please install inotify-tools:"
    err "  sudo dnf install -y inotify-tools   # RHEL/CentOS/Fedora"
    err "  sudo apt install -y inotify-tools   # Debian/Ubuntu"
    exit 1
fi

log "Watching directory in real time: ${REPO_PATH}"

# Exclusions: the .git directory (otherwise git's own writes trigger an endless loop),
# the sync log, and any user-defined patterns
EXCLUDE='/\.git($|/)|/\.git$|git_sync.*\.log$'
if [ -n "$EXTRA_EXCLUDE" ]; then
    EXCLUDE="${EXCLUDE}|${EXTRA_EXCLUDE}"
fi

# Debounce loop:
#   read -t N returns when no new event arrives within N seconds, meaning the
#   directory went quiet; that is when we sync once. This merges the continuous
#   changes inside the window into a single commit (same 3s debounce semantics
#   as the Windows version).
pending=0
while true; do
    if read -r -t "$DEBOUNCE" _line; then
        pending=1
        continue
    fi
    if [ "$pending" -eq 1 ]; then
        pending=0
        sync_now
    fi
done < <(inotifywait -m -r -q \
    -e modify -e create -e delete -e move -e close_write \
    --exclude "$EXCLUDE" \
    --format '%w%f' "$REPO_PATH" 2>/dev/null)
