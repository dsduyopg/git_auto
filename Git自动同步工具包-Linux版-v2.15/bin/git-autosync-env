#!/usr/bin/env bash
# ============================================================
# Git AutoSync Toolkit (Linux) - environment check
# Ported from the Windows version: environment-check.bat
# Checks: Git / inotify-tools / SSH key / systemd / python3 (mail optional)
# ============================================================

set -uo pipefail

SELF_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SELF_DIR="$(cd "$(dirname "$SELF_PATH")" && pwd)"
# shellcheck source=/dev/null
. "${SELF_DIR}/../lib/common.sh"

title "Git AutoSync Toolkit - Environment Check"
hr

fatal=0

# ---- 1. Git ----
if need_cmd git; then
    ok "Git installed: $(git --version)"
else
    err "Git is not installed (required)"
    echo "    Install: sudo dnf install -y git     # RHEL/CentOS/Fedora/Alma"
    echo "             sudo apt install -y git     # Debian/Ubuntu"
    fatal=1
fi

# ---- 2. inotify-tools (required for real-time watching) ----
if need_cmd inotifywait; then
    ok "inotify-tools installed (real-time watching available)"
else
    err "inotify-tools is not installed (required for real-time watching)"
    echo "    Install: sudo dnf install -y inotify-tools"
    echo "             sudo apt install -y inotify-tools"
    fatal=1
fi

# ---- 3. SSH key ----
ssh_dir="${HOME}/.ssh"
if [ -d "$ssh_dir" ]; then
    keys="$(find "$ssh_dir" -maxdepth 1 -type f \
        ! -name '*.pub' ! -name 'known_hosts' ! -name 'config' \
        ! -name 'authorized_keys' 2>/dev/null | sort)"
    if [ -n "$keys" ]; then
        ok "SSH private keys:"
        echo "$keys" | while read -r k; do echo "    - $k"; done
        pub="$(find "$ssh_dir" -maxdepth 1 -name '*.pub' 2>/dev/null | head -n1)"
        if [ -n "$pub" ]; then
            echo "    Public key (add this to Gitee/GitHub):"
            sed 's/^/      /' "$pub"
        fi
    else
        warn "~/.ssh exists but contains no private key. Generate one with: git-autosync ssh-key"
    fi
else
    warn "SSH directory not found: ${ssh_dir}. Generate a key with: git-autosync ssh-key"
fi

# ---- 4. systemd ----
if has_systemd; then
    ok "systemd available (runs as a service)"
else
    warn "systemd is not running here (common in WSL/containers)"
    echo "    You can still run: git-autosync-sync <repo-name> in the foreground"
fi

# ---- 5. python3 (optional, for email notification) ----
if need_cmd python3; then
    ok "python3 installed (email notification available)"
else
    warn "python3 is not installed; email notification is unavailable (sync is unaffected)"
fi

# ---- 6. Install location and configuration ----
hr
if [ -d "$PREFIX" ]; then
    ok "Install directory: ${PREFIX}"
else
    warn "Install directory not found: ${PREFIX} (if running from source, set GIT_AUTOSYNC_PREFIX to this directory)"
fi

if [ -d "$CONF_DIR" ]; then
    ok "Config directory: ${CONF_DIR}"
    repos="$(list_repos)"
    if [ -n "$repos" ]; then
        echo "    Registered repositories:"
        printf '%s\n' "$repos" | sed 's/^/      - /'
    else
        echo "    No repositories registered yet"
    fi
else
    warn "Config directory not found: ${CONF_DIR} (install.sh creates it automatically)"
fi

hr
if [ "$fatal" -eq 0 ]; then
    ok "Environment check passed. You can start with: git-autosync"
else
    err "Missing required dependencies. Install them as shown above, then try again"
fi
exit "$fatal"
